# OpenAI API 配置
# 从 https://platform.openai.com/api-keys 获取你的 API Key
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI API 基础 URL（可选）
# 如果使用第三方代理或自定义端点，可以修改此项
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI 模型配置（可选）
# 默认使用 gpt-4o-mini，可以根据需要修改
# OPENAI_MODEL=gpt-4o-mini

# 数据库配置
# PGlite 使用本地存储，无需额外配置
# 数据存储位置：浏览器 IndexedDB 或桌面应用本地文件

# 应用配置（可选）
# NODE_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000
